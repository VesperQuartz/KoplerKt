<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.KoplerKt" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/whisper_primary</item>
        <item name="colorPrimaryVariant">@color/whisper_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/whisper_primary</item>
        <item name="colorSecondaryVariant">@color/whisper_primary_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/whisper_primary</item>
        <item name="android:navigationBarColor">@color/whisper_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/whisper_surface</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="Theme.KoplerKt.NoActionBar" parent="Theme.KoplerKt" />

    <style name="Theme.KoplerKt.DemoBank" parent="Theme.KoplerKt">
        <item name="android:statusBarColor">@color/demo_bank_blue</item>
    </style>

    <style name="Theme.KoplerKt.Overlay" parent="Theme.KoplerKt">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:statusBarColor">#99000000</item>
        <item name="android:navigationBarColor">#99000000</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
